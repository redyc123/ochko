# Authorization key из личного кабинета GigaChat (Basic, base64 client_id:secret).
# Читается только сервер (server/main.py) — в бандл приложения не попадает.
GIGA_CHAT_AUTH_TOKEN=
# GIGA_CHAT_SCOPE=GIGACHAT_API_PERS
# SERVER_PORT=8787

# EXPO_PUBLIC_AGENT_PROXY_URL — в client/.env (адрес этого сервера; на телефоне — IP компьютера).
